<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 승인된 범위의 퍼미션만 선언할 것. AppContainer의 CoreFeature와 맞춘다 -->
    <!-- 기어·브레이크·조향·크루즈 → CoreFeature.DRIVE -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 차속(AAOS, dangerous → 런타임 동의) → CoreFeature.SPEED. 앱마켓 승인 대상인지 미확인(PRD 5.2) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 내비 위치·혼잡 구간 → CoreFeature.NAVI -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application
        android:name=".CruiseBreakerApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- DO 선언: 주행 중에도 S1을 보여 준다. 주행 중 화면 규정을 지킬 것(PRD 5.5) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
